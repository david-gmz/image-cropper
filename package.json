{
  "name": "image-cropper",
  "version": "1.2.0",
  "description": "Generic reusable cropper - 1 tool + cropper.config.mjs per project - webp+avif - no collision",
  "type": "module",
  "bin": {
    "cropper": "./cropper.mjs",
    "image-cropper": "./cropper.mjs"
  },
  "scripts": {
    "init": "pwsh -File ./init-cropper.ps1",
    "init:flat": "pwsh -Command \". ./init-cropper.ps1; New-CropperInputTree -Flat -WithReadme\"",
    "init:service": "pwsh -Command \". ./init-cropper.ps1; New-CropperInputTree -FromConfig ./cropper.config.delisnack.mjs -WithReadme\"",
    "clean": "pwsh -Command \". ./init-cropper.ps1; Clear-CropperDist\"",
    "copy": "pwsh -Command \". ./init-cropper.ps1; Copy-CropperDist\"",
    "copy:box-lunch": "pwsh -Command \". ./init-cropper.ps1; Copy-CropperDist -Services box-lunch\"",
    "copy:multi": "pwsh -Command \". ./init-cropper.ps1; Copy-CropperDist -Services @('box-lunch','canapes')\"",
    "crop": "node cropper.mjs --config=cropper.config.delisnack.mjs",
    "crop:manifest": "node cropper.mjs --config=cropper.config.delisnack.mjs --manifest",
    "crop:box-lunch": "node cropper.mjs --config=cropper.config.delisnack.mjs --service=box-lunch --manifest",
    "crop:2": "node cropper.mjs --config=cropper.config.delisnack.mjs --service=box-lunch,canapes --manifest",
    "crop:all": "node cropper.mjs --config=cropper.config.delisnack.mjs --service=all --manifest",
    "deploy": "pwsh -Command \". ./init-cropper.ps1; Deploy-Cropper -Services all\"",
    "deploy:box-lunch": "pwsh -Command \". ./init-cropper.ps1; Deploy-Cropper -Services box-lunch\"",
    "deploy:coffee-break": "pwsh -Command \". ./init-cropper.ps1; Deploy-Cropper -Services coffee-break\""
  },
  "keywords": [
    "sharp",
    "image",
    "crop",
    "webp",
    "avif",
    "responsive",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fs-extra": "^11.2.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.4.1"
  },
  "packageManager": "pnpm@12.4.2"
}