{
  "name": "image-cropper",
  "version": "1.0.0",
  "description": "Generic reusable cropper - 1 tool + cropper.config.mjs per project - webp+avif - no collision",
  "type": "module",
  "bin": {
    "cropper": "./cropper.mjs",
    "image-cropper": "./cropper.mjs"
  },
  "scripts": {
    "init": "pwsh -File ./init-cropper.ps1",
    "init:flat": "pwsh -Command \". ./init-cropper.ps1; New-CropperInputTree -Flat -WithReadme\"",
    "crop": "node cropper.mjs",
    "crop:manifest": "node cropper.mjs --manifest",
    "crop:box-lunch": "node cropper.mjs --service=box-lunch --manifest",
    "crop:all": "node cropper.mjs --service=all --manifest",
    "clean": "node -e \"import('fs-extra').then(m=>m.default.emptyDir('./dist'))\"",
    "copy": "node -e \"import fs from 'fs-extra'; const dest = process.env.DEST || 'C:/laragon/www/delisnack/public/assets/images/services'; await fs.ensureDir(dest); await fs.copy('./dist', dest, {overwrite:true}); console.log('\u2713 Copied to '+dest)\"",
    "deploy": "node cropper.mjs --service=all --manifest && pnpm run copy"
  },
  "keywords": [
    "sharp",
    "image-cropper",
    "webp",
    "avif",
    "responsive",
    "config"
  ],
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fs-extra": "^11.2.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.4.1"
  },
  "packageManager": "pnpm@12.4.1"
}